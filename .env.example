# Copy to .env before `docker compose up`. Do not commit .env.
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Inside Docker Compose these hosts are overridden to the service names.
# Host port for Postgres. Use another port if 5432 is already taken on your machine.
POSTGRES_PUBLISH_PORT=5432
DATABASE_URL=postgres://eve:eve@db:5432/eve
POSTGRES_DB=eve
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
# Host port for Redis. Use another port if 6379 is already taken on your machine.
REDIS_PUBLISH_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

WEBHOOK_SECRET=dev-webhook-secret-replace-me
# Replace the value above with a long random string before `docker compose up`.
# The app will not start with DEBUG=False while this placeholder remains.
PAYMENT_SUCCESS_RATE=0.8
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Set true on first boot to load demo centres, tests and users.
SEED_DATA=true
